# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# `next dev` recreates this ONLY if CLAUDE.md stops hosting its managed block
# (see the BEGIN/END markers at the top of CLAUDE.md). CLAUDE.md itself is
# tracked — it carries real project instructions, not just the Next.js block.
/AGENTS.md

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the blank template, which documents the required variables.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
