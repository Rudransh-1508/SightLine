# Sightline — environment template
#
# This file IS committed. It documents the required variables — never put
# real values here. Copy it to .env.local and fill that in instead.
#
# See docs/superpowers/specs/2026-08-06-ai-integration-design.md

# ---------------------------------------------------------------------------
# Database — Neon Postgres
# ---------------------------------------------------------------------------
# Create a project at https://neon.tech and copy the *pooled* connection string.
# Must include ?sslmode=require
DATABASE_URL=

# Direct (non-pooled) connection. Drizzle migrations need this — running
# migrations through a connection pooler is unreliable.
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# LLM — Groq (primary) + OpenRouter (fallback)
# ---------------------------------------------------------------------------
# Per docs/superpowers/specs/2026-08-06-groq-provider-fallback-design.md:
# triage and extraction try Groq first, falling back to OpenRouter only on an
# actual 429. Two real accounts, each within its own published limits — do
# NOT add multiple keys to one provider to work around its rate limit. Both
# Groq's and OpenRouter's terms prohibit that, and Groq enforces limits at the
# organisation level, not per-key, so it would not even work mechanically.

# https://console.groq.com/keys
GROQ_API_KEY=

# Verified live (2026-08-06) to have genuine constrained-decoding structured
# output on Groq's own infrastructure — Groq's docs confirm this only for a
# short list of models; do not assume it holds for others without checking.
# Groq's smallest/cheapest tier, chosen deliberately over larger models to
# avoid exhausting the daily quota faster for no reliability gain.
GROQ_TRIAGE_MODEL=openai/gpt-oss-20b
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Fallback models. Only a minority of ":free" models support strict
# JSON-schema output, and "supports" per the catalogue doesn't always hold
# under live testing — do NOT use "openrouter/free": it picks a random free
# model per request, which destroys eval reproducibility.
#
# Verified live 2026-08-06 to genuinely honour strict structured output:
#   triage   nvidia/nemotron-nano-9b-v2:free
#            (openai/gpt-oss-20b:free was tried first but verified to ignore
#            response_format json_schema entirely on OpenRouter's routing,
#            returning free-form prose regardless of reasoning settings —
#            do not use it here, even though the SAME model works on Groq's
#            own infrastructure. The failure was in OpenRouter's routing, not
#            the model itself.)
#   extract  nvidia/nemotron-3-super-120b-a12b:free
#   copilot  nvidia/nemotron-3-ultra-550b-a55b:free (unchanged by the Groq switch)
#
# Reasoning-capable free models spend tokens on an internal reasoning trace
# BEFORE the visible JSON — invisible in the response content but real in
# usage.completion_tokens_details.reasoning_tokens. max_tokens must have
# headroom for this or the response truncates with empty content
# (finish_reason: "length"). See src/lib/llm/openrouter.ts and groq.ts.
OPENROUTER_TRIAGE_MODEL=
OPENROUTER_EXTRACT_MODEL=
OPENROUTER_COPILOT_MODEL=

# Optional: OpenRouter attributes traffic and shows these on your dashboard.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# ---------------------------------------------------------------------------
# Auth — WorkOS AuthKit
# ---------------------------------------------------------------------------
# https://dashboard.workos.com — API Keys, and Applications > Configuration
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# Must exactly match the Redirect URI configured in the WorkOS dashboard.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=

# ---------------------------------------------------------------------------
# News sources
# ---------------------------------------------------------------------------
# Guardian Open Platform — free developer key, supplies FULL article body text.
# Request at https://open-platform.theguardian.com/access/ (emailed instantly).
# Free tier is non-commercial: 5,000 calls/day, 12 calls/sec.
GUARDIAN_API_KEY=

# GDELT DOC 2.0 needs no key and no signup — nothing to set here.
# Left as a marker so the source adapter can be toggled off without code changes.
GDELT_ENABLED=

# ---------------------------------------------------------------------------
# Ingestion guards
# ---------------------------------------------------------------------------
# Hard ceiling per ingestion run. The run aborts when reached — it does not warn
# and continue. Prevents a runaway loop from draining credits or spend.
INGEST_MAX_CREDITS_PER_RUN=

# Documents fetched per source per run, before filtering. Fetching is free —
# only the docs surviving the deterministic prefilter reach a model.
INGEST_MAX_DOCS_PER_RUN=

# OpenRouter free tier allows 20 req/min and 50 req/DAY (1,000/day once $10 has
# ever been purchased). Guard the daily cap so a run cannot silently exhaust it.
INGEST_MAX_LLM_CALLS_PER_RUN=

# Documents per batched triage call. Batching is what keeps the pipeline inside
# 50 requests/day: 20 docs cost one call, not twenty.
INGEST_TRIAGE_BATCH_SIZE=
